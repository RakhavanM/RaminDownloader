<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RaminDownloader.Desktop.MainWindow"
        Title="Ramin Downloader" Width="900" Height="740" MinWidth="620" MinHeight="530"
        RequestedThemeVariant="Dark" Background="#101321" Foreground="#F5F3FF">
  <Window.Styles>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="#BDC3DD"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#AFA2FF"/>
      <Setter Property="Foreground" Value="#181132"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="18,10"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1B2033"/>
      <Setter Property="BorderBrush" Value="#343B58"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="24"/>
    </Style>
  </Window.Styles>
  <Grid Margin="24" RowDefinitions="Auto,*,Auto" RowSpacing="14">
    <Border CornerRadius="18" Padding="24,18">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#40248E" Offset="0"/>
          <GradientStop Color="#23467F" Offset="0.66"/>
          <GradientStop Color="#115E63" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <StackPanel Spacing="5">
        <TextBlock Text="MEDIA WORKSPACE" Foreground="#D7CEFF" FontSize="12" FontWeight="Bold"/>
        <TextBlock Text="Ramin Downloader" FontWeight="Bold" FontSize="33"/>
        <TextBlock Text="Download, resize, compress, and convert." Foreground="#F0EBFF"/>
      </StackPanel>
    </Border>
    <TabControl x:Name="Workspace" Grid.Row="1">
      <TabItem Header="Download">
        <ScrollViewer>
          <Border Classes="card" Margin="0,10,0,0">
            <StackPanel Spacing="12">
              <TextBlock Classes="section" Text="Download from a link" Foreground="#C4B5FD"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="Url" Watermark="https://…" AutomationProperties.Name="Video URL"/>
                <Button Grid.Column="1" Content="Paste" Click="PasteLink"/>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <StackPanel Spacing="4">
                  <TextBlock Classes="caption" Text="Output"/>
                  <ComboBox x:Name="DownloadTypeBox" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Download output">
                    <ComboBoxItem Content="Video"/>
                    <ComboBoxItem Content="MP3 audio"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Classes="caption" Text="Quality"/>
                  <ComboBox x:Name="DownloadQualityBox" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Download quality">
                    <ComboBoxItem Content="Highest"/>
                    <ComboBoxItem Content="Medium"/>
                    <ComboBoxItem Content="Lowest"/>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <CheckBox x:Name="Cookies" Content="Use my Firefox sign-in" IsCheckedChanged="CookiesChanged"/>
              <Grid x:Name="ProfileRow" IsVisible="False" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="FirefoxProfile" Watermark="Auto-detect profile (optional)" AutomationProperties.Name="Firefox profile directory"/>
                <Button Grid.Column="1" Content="Choose profile" Click="ChooseProfile"/>
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="DownloadFolder" IsReadOnly="True" AutomationProperties.Name="Download folder"/>
                <Button Grid.Column="1" Content="Choose folder" Click="ChooseDownloadFolder"/>
              </Grid>
              <Button Classes="primary" Content="Download" Click="StartDownload"/>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="File tools">
        <ScrollViewer>
          <Border x:Name="FileCard" Classes="card" Margin="0,10,0,0" DragDrop.AllowDrop="True">
            <StackPanel Spacing="12">
              <TextBlock Classes="section" Text="Work with a local file" Foreground="#78E9D0"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="InputFile" IsReadOnly="True" Watermark="Drop an audio or video file here" AutomationProperties.Name="Input file"/>
                <Button Grid.Column="1" Content="Choose file" Click="ChooseInput"/>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <StackPanel Spacing="4">
                  <TextBlock Classes="caption" Text="Operation"/>
                  <ComboBox x:Name="Operation" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Media operation">
                    <ComboBoxItem Content="Resize video"/>
                    <ComboBoxItem Content="Compress video"/>
                    <ComboBoxItem Content="Convert audio or video"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel x:Name="ResizePanel" Grid.Column="1" Spacing="4">
                  <TextBlock Classes="caption" Text="Maximum height (pixels)"/>
                  <NumericUpDown x:Name="HeightBox" Value="720" Minimum="64" Maximum="4320" Increment="2" FormatString="0" AutomationProperties.Name="Maximum video height"/>
                </StackPanel>
                <StackPanel x:Name="CompressPanel" Grid.Column="1" Spacing="4" IsVisible="False">
                  <TextBlock Classes="caption" Text="Compression"/>
                  <ComboBox x:Name="Compression" SelectedIndex="1" HorizontalAlignment="Stretch" AutomationProperties.Name="Compression level">
                    <ComboBoxItem Content="Light · higher quality"/>
                    <ComboBoxItem Content="Balanced"/>
                    <ComboBoxItem Content="Strong · smaller file"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel x:Name="ConvertPanel" Grid.Column="1" Spacing="4" IsVisible="False">
                  <TextBlock Classes="caption" Text="Output format"/>
                  <ComboBox x:Name="FormatBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Output format"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="MediaHint" Classes="caption"/>
              <Button Classes="primary" Content="Choose output and start" Click="StartMedia"/>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Classes="card" Padding="16,12">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
        <TextBlock x:Name="Status" Text="Ready" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="OpenOutput" IsVisible="False" Content="Open folder" Click="OpenFolder"/>
          <Button x:Name="Cancel" IsEnabled="False" Content="Cancel" Click="CancelJob"/>
        </StackPanel>
        <ProgressBar x:Name="Progress" Grid.Row="1" Grid.ColumnSpan="2" Maximum="100" Height="5" Foreground="#76E6CD" AutomationProperties.Name="Job progress"/>
        <Expander x:Name="ErrorDetails" Grid.Row="2" Grid.ColumnSpan="2" IsVisible="False"
                  Header="Technical details" HorizontalAlignment="Stretch">
          <TextBox x:Name="TechnicalDetails" IsReadOnly="True" MaxHeight="130" TextWrapping="Wrap"
                   AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   FontFamily="monospace" AutomationProperties.Name="Technical error details"/>
        </Expander>
      </Grid>
    </Border>
  </Grid>
</Window>
