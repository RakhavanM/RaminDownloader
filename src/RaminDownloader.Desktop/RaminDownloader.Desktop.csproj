<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RaminDownloader.Desktop</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationIcon>../RaminDownloader/Assets/RaminDownloader.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <Compile Include="../RaminDownloader/Models/DownloadOptions.cs" Link="Download/DownloadOptions.cs" />
    <Compile Include="../RaminDownloader/Services/YtDlpArgumentsBuilder.cs" Link="Download/YtDlpArgumentsBuilder.cs" />
    <Compile Include="../RaminDownloader/Services/ProgressParser.cs" Link="Download/ProgressParser.cs" />
  </ItemGroup>
</Project>
