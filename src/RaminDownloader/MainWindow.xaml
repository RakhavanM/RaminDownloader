<Window x:Class="RaminDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RaminDownloader" Icon="/RaminDownloader;component/Assets/RaminDownloader.ico" Height="620" Width="760"
        MinHeight="560" MinWidth="680"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,18">
            <Image x:Name="LogoImage" Source="{StaticResource AppLogo}" Width="92" Height="92" Stretch="Uniform" Margin="0,0,18,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="RAMIN" FontSize="26" FontWeight="Bold" Foreground="#D70000" />
                <TextBlock Text="DOWNLOADER" FontSize="14" FontWeight="SemiBold" Foreground="#D70000" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="URL" VerticalAlignment="Center" Margin="0,0,14,12" />
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UrlTextBox" Grid.Column="0" Height="32" Padding="8,5" />
            <Button x:Name="PasteButton" Grid.Column="1" Content="Paste" Width="90" Height="32" Margin="8,0,0,0" Click="PasteButton_Click" />
        </Grid>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Type" VerticalAlignment="Center" Margin="0,0,14,12" />
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="VideoRadioButton" Content="Video" GroupName="DownloadType" IsChecked="True" Margin="0,0,20,0" />
            <RadioButton x:Name="AudioRadioButton" Content="Audio (MP3)" GroupName="DownloadType" />
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Quality" VerticalAlignment="Center" Margin="0,0,14,12" />
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="HighestQualityRadioButton" Content="Highest" GroupName="DownloadQuality" IsChecked="True" Margin="0,0,20,0" />
            <RadioButton x:Name="MediumQualityRadioButton" Content="Medium" GroupName="DownloadQuality" Margin="0,0,20,0" />
            <RadioButton x:Name="LowestQualityRadioButton" Content="Lowest" GroupName="DownloadQuality" />
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
            <Border Background="#FFF5E6" BorderBrush="#FFE0A3" BorderThickness="1" Padding="12" Margin="0,4,0,14">
                <TextBlock TextWrapping="Wrap">Install Firefox and sign in to the website you want to download from. Complete any verification there, then close Firefox before downloading. RaminDownloader uses Firefox cookies locally through yt-dlp; it never uploads or stores your cookies.</TextBlock>
            </Border>
            <ProgressBar x:Name="DownloadProgressBar" Height="22" Minimum="0" Maximum="100" Margin="0,0,0,10" />
            <TextBlock x:Name="StatusTextBlock" Text="Ready" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Border BorderBrush="#D0D0D0" BorderThickness="1" Padding="8" MinHeight="70" MaxHeight="110">
                <TextBlock x:Name="LatestOutputTextBlock"
                           Text="Latest yt-dlp output will appear here."
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="100" Height="34" Margin="0,0,10,0" Click="CancelButton_Click" IsEnabled="False" />
            <Button x:Name="DownloadButton" Content="Download" Width="120" Height="34" Click="DownloadButton_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
