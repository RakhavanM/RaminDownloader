<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RaminYtDlpControl</RootNamespace>
    <AssemblyName>RaminYtDlpControl</AssemblyName>
    <Version>0.6.0</Version>
    <AssemblyVersion>0.6.0.0</AssemblyVersion>
    <FileVersion>0.6.0.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../RaminDownloader/Services/ToolLocator.cs" Link="Services/ToolLocator.cs" />
    <Compile Include="../RaminDownloader/Services/ToolManager.cs" Link="Services/ToolManager.cs" />
    <Compile Include="../RaminDownloader/Services/AppUpdateManager.cs" Link="Services/AppUpdateManager.cs" />
    <None Include="../RaminDownloader/Assets/tools-manifest.json" Link="Assets/tools-manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
