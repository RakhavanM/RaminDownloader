<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/RaminDownloader.Desktop/ToolProcess.cs" Link="ToolProcess.cs" />
    <Compile Include="../../src/RaminDownloader.Desktop/MediaJobs.cs" Link="MediaJobs.cs" />
    <Compile Include="../../src/RaminDownloader.Desktop/JobError.cs" Link="JobError.cs" />
    <Compile Include="../../src/RaminDownloader/Models/DownloadOptions.cs" Link="DownloadOptions.cs" />
    <Compile Include="../../src/RaminDownloader/Services/YtDlpArgumentsBuilder.cs" Link="YtDlpArgumentsBuilder.cs" />
    <Compile Include="../../src/RaminDownloader/Services/ProgressParser.cs" Link="ProgressParser.cs" />
    <None Include="$(BundledTools)/*" Link="tools/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="'$(BundledTools)' != ''" />
  </ItemGroup>
</Project>
